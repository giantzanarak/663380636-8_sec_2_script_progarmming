# Copy to .env and fill in:   cp .env.example .env      (.env is git-ignored - never commit it)

# Gmail address and 16-character App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=your_16_digit_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com

# Where the test emails go (can be your own address)
TEST_RECIPIENT_EMAIL=your_email@gmail.com

# SMS via email-to-SMS gateway: 10-digit number + carrier (att, verizon, tmobile, sprint, boost, cricket, us_cellular).
# Thai carriers have no gateway - put an email address here and leave the carrier empty to receive the "SMS" as an email.
TEST_SMS_PHONE_NUMBER=your_email@gmail.com
TEST_SMS_CARRIER=

# Text put in every email/SMS body (the lab asks for your full name and student ID)
STUDENT_INFO=ชื่อ-นามสกุล รหัสนักศึกษา
