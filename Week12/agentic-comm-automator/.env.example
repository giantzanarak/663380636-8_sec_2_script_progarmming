# Copy this file to .env and fill in your own values:   cp .env.example .env
# .env is listed in .gitignore - never commit it.

# "live" = send/receive through Gmail, "mock" = offline mailbox in data/ (no account needed).
# Leave empty to use live when SENDER_EMAIL and SENDER_APP_PASSWORD are set, otherwise mock.
COMM_MODE=

SENDER_EMAIL=your_gmail_address@gmail.com
# Gmail App Password (16 characters), NOT your normal password:
# Google Account -> Security -> 2-Step Verification -> App passwords
SENDER_APP_PASSWORD=your_generated_gmail_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com

# Recipient for the report email (can be your own address)
TEST_RECIPIENT_EMAIL=your_gmail_address@gmail.com

# SMS goes through an email-to-SMS gateway (e.g. 1234567890 + carrier "att" -> 1234567890@txt.att.net).
# Thai carriers have no such gateway, so put an email address here and leave the carrier empty:
# the "SMS" is then delivered to that inbox as a short email.
TEST_SMS_PHONE_NUMBER=your_gmail_address@gmail.com
TEST_SMS_CARRIER=
